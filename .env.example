# URL of the Tuff FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Firebase web app config (Project settings -> Your apps).
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Razorpay publishable key id (safe to expose).
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Must match ENCRYPTION_KEY in backend/.env exactly. Encrypts AWS keys before
# they are stored in the browser or sent to the API. At least 16 characters.
#
# This value ships in the client bundle, so it is not a defence against an
# attacker who can run script in the page -- it protects against casual
# inspection of browser storage and accidental logging. Generate with:
#   openssl rand -hex 16
NEXT_PUBLIC_ENCRYPTION_KEY=
