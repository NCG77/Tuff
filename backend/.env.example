BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Set to "production" for real deployments. In production Tuff refuses to start
# without ENCRYPTION_KEY, disables /docs, and rejects unencrypted credentials.
ENVIRONMENT=development

# Comma-separated list of exact browser origins allowed to call this API.
# Wildcards are not supported: credentialed cross-origin requests require an
# explicit origin.
FRONTEND_URL=http://localhost:3000

OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
GROQ_API_KEY=gsk_your_groq_api_key_here

DATABASE_URL=postgresql://your_db_user:your_db_password@your_host/your_db_name

# Project ID from the Firebase Console. Required: user identity cannot be
# verified without it.
FIREBASE_PROJECT_ID=your_firebase_project_id

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Shared with the browser as NEXT_PUBLIC_ENCRYPTION_KEY. Encrypts AWS keys in
# transit and in browser storage. Must be at least 16 characters and identical
# on both sides. Generate with: openssl rand -hex 16
ENCRYPTION_KEY=

# Required to accept AWS EventBridge/SNS deliveries at /api/webhooks/aws.
# Send it as the X-Tuff-Webhook-Secret header. Leave blank to disable the
# webhook entirely. Generate with: openssl rand -hex 32
AWS_WEBHOOK_SECRET=
